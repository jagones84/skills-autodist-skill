{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/giova",
        "C:/PYTHON",
        "C:/AI_MODELS",
        "F:/MCP",
        "F:/REPOSITORIES",
        "F:/PROGRAMS"
      ],
      "transportType": "stdio",
      "alwaysAllow": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "edit_file",
        "create_directory",
        "list_directory",
        "directory_tree",
        "move_file",
        "search_files",
        "get_file_info",
        "list_allowed_directories",
        "list_files"
      ],
      "disabled": false
    },
    "Multi-Fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@lmcc-dev/mult-fetch-mcp-server"
      ],
      "disabled": true
    },
    "Example Remote MCP (mcp-remote)": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://example.com/mcp",
        "--header",
        "Authorization: Bearer ${YOUR_TOKEN_HERE}"
      ],
      "disabled": true,
      "timeout": 600,
      "transportType": "stdio"
    }
  }
}

